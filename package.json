{
  "name": "otak-paste",
  "displayName": "otak-paste",
  "description": "%extension.description%",
  "publisher": "odangoo",
  "license": "MIT",
  "icon": "images/otak-paste-icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsuyoshi-otake/otak-paste"
  },
  "bugs": {
    "url": "https://github.com/tsuyoshi-otake/otak-paste/issues"
  },
  "homepage": "https://github.com/tsuyoshi-otake/otak-paste#readme",
  "version": "0.2.0",
  "files": [
    "out/configuration.js",
    "out/configuration.js.map",
    "out/constants.js",
    "out/constants.js.map",
    "out/extension.js",
    "out/extension.js.map",
    "out/pathing.js",
    "out/pathing.js.map",
    "out/pasteImageProvider.js",
    "out/pasteImageProvider.js.map",
    "out/pngOptimizationMode.js",
    "out/pngOptimizationMode.js.map",
    "out/pngOptimizer.js",
    "out/pngOptimizer.js.map",
    "out/i18n/**/*.js",
    "out/i18n/**/*.js.map",
    "out/i18n/locales/*.json",
    "images/**",
    "package.nls*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "%capabilities.untrustedWorkspaces%"
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "otakPaste.pngOptimization": {
          "type": "string",
          "scope": "resource",
          "default": "lossless",
          "enum": [
            "lossless",
            "none"
          ],
          "enumDescriptions": [
            "%configuration.pngOptimization.lossless%",
            "%configuration.pngOptimization.none%"
          ],
          "markdownDescription": "%configuration.pngOptimization.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "gen:nls": "node scripts/gen-package-nls.mjs",
    "copy:locales": "node scripts/copy-locales.mjs",
    "compile": "npm run gen:nls && tsc -p ./ && npm run copy:locales",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "npm run compile && node scripts/run-unit-tests.mjs",
    "package": "npm run compile && vsce package"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3"
  }
}
